# Operator supplied values. This file contains no credentials.
HOST=127.0.0.1
PORT=3001
PUBLIC_OPERATION=true
ALLOWED_ORIGINS=https://your-domain.example
DATABASE_PATH=/var/lib/last-signal/rooms.sqlite
PERSISTENT_STORAGE_CONFIRMED=true
TLS_TERMINATED=true
BUILD_REVISION=replace-with-commit
